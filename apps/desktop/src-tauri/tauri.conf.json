{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "1.0.0",
  "identifier": "dev.sift.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sift",
        "url": "index.html",
        "width": 680,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "pdfium/": "pdfium/",
      "vcruntime/msvcp140.dll": "msvcp140.dll",
      "vcruntime/msvcp140_1.dll": "msvcp140_1.dll",
      "vcruntime/vcruntime140.dll": "vcruntime140.dll",
      "vcruntime/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
